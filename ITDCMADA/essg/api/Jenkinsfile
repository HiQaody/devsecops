pipeline {
    agent any

    environment {
        CONTAINER_NAME      = 'essg-front'
        IMAGE_NAME          = 'essg-front'
        IMAGE_TAG           = "${BUILD_NUMBER}"
        VITE_PORT           = '3170'
        VITE_API_BASE_URL   = 'https://essg-api.itdcmada.com'
        
        // Gestion Memory
        MEMORY_LIMIT        = '512m'
        MEMORY_RESERVATION  = '256m'
        CPU_SHARES          = '512'
        
        // Logs
        LOG_DIR             = '/var/log/docker/${CONTAINER_NAME}'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "📦 Récupération du code source..."
                    checkout scm
                    echo "✅ Code source récupéré avec succès"
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    echo "🔍 Validation des fichiers..."
                    sh '''
                        # Vérifier que les fichiers essentiels existent
                        [ -f "package.json" ] || (echo "❌ package.json manquant" && exit 1)
                        [ -f "Dockerfile" ] || (echo "❌ Dockerfile manquant" && exit 1)
                        [ -f "vite.config.ts" ] || (echo "❌ vite.config.ts manquant" && exit 1)
                        echo "✅ Tous les fichiers essentiels sont présents"
                    '''
                }
            }
        }

        stage('Clean Old Images') {
            steps {
                script {
                    echo "🧹 Nettoyage des anciennes images..."
                    sh '''
                        # Supprimer les images dangling
                        docker image prune -f --filters "dangling=true" || true
                        
                        # Garder seulement les 5 dernières versions
                        docker images ${IMAGE_NAME} --format "{{.ID}}" | tail -n +6 | xargs -r docker rmi -f || true
                        echo "✅ Nettoyage terminé"
                    '''
                }
            }
        }

        stage('Build Image') {
            steps {
                script {
                    echo "🔨 Construction de l'image Docker..."
                    sh '''
                        docker build \
                          --build-arg VITE_PORT=${VITE_PORT} \
                          --build-arg VITE_API_BASE_URL=${VITE_API_BASE_URL} \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} \
                          -t ${IMAGE_NAME}:latest .
                        
                        echo "✅ Image construite : ${IMAGE_NAME}:${IMAGE_TAG}"
                        docker images | grep ${IMAGE_NAME}
                    '''
                }
            }
        }

        stage('Health Check Image') {
            steps {
                script {
                    echo "🏥 Vérification de l'image..."
                    sh '''
                        # Vérifier que l'image a bien été créée
                        if docker inspect ${IMAGE_NAME}:${IMAGE_TAG} > /dev/null 2>&1; then
                            echo "✅ Image valide"
                            docker inspect ${IMAGE_NAME}:${IMAGE_TAG} | grep -E "Id|RepoTags" | head -5
                        else
                            echo "❌ Erreur : Image non trouvée"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                script {
                    echo "🛑 Arrêt de l'ancien conteneur..."
                    sh '''
                        if [ "$(docker ps -aq -f name=${CONTAINER_NAME})" ]; then
                            echo "🔴 Conteneur ${CONTAINER_NAME} détecté, arrêt en cours..."
                            docker stop ${CONTAINER_NAME} || true
                            sleep 2
                            docker rm ${CONTAINER_NAME} || true
                            echo "✅ Ancien conteneur supprimé"
                        else
                            echo "ℹ️ Aucun conteneur ${CONTAINER_NAME} en cours d'exécution"
                        fi
                    '''
                }
            }
        }

        stage('Deploy Container') {
            steps {
                script {
                    echo "🚀 Déploiement du nouveau conteneur..."
                    sh '''
                        # Créer le répertoire de logs s'il n'existe pas
                        mkdir -p ${LOG_DIR}
                        
                        # Démarrer le conteneur
                        docker run -d \
                            --memory ${MEMORY_LIMIT} \
                            --memory-reservation ${MEMORY_RESERVATION} \
                            --cpu-shares ${CPU_SHARES} \
                            --name ${CONTAINER_NAME} \
                            -p ${VITE_PORT}:${VITE_PORT} \
                            --restart unless-stopped \
                            -e VITE_API_BASE_URL=${VITE_API_BASE_URL} \
                            -e VITE_PORT=${VITE_PORT} \
                            --log-driver json-file \
                            --log-opt max-size=10m \
                            --log-opt max-file=3 \
                            ${IMAGE_NAME}:${IMAGE_TAG}
                        
                        echo "✅ Conteneur démarré"
                        sleep 3
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    echo "🔍 Vérification du déploiement..."
                    sh '''
                        # Vérifier que le conteneur est en cours d'exécution
                        if docker ps -a --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"; then
                            STATUS=$(docker inspect -f '{{.State.Status}}' ${CONTAINER_NAME})
                            echo "📊 Statut du conteneur : ${STATUS}"
                            
                            if [ "${STATUS}" = "running" ]; then
                                echo "✅ Le conteneur est en cours d'exécution"
                                
                                # Afficher les infos du conteneur
                                echo "📋 Informations du conteneur :"
                                docker inspect ${CONTAINER_NAME} | grep -E "\"Id\"|\"Image\"|\"State\"" | head -10
                            else
                                echo "❌ Le conteneur n'est pas en cours d'exécution"
                                echo "Logs du conteneur :"
                                docker logs ${CONTAINER_NAME} || true
                                exit 1
                            fi
                        else
                            echo "❌ Le conteneur ${CONTAINER_NAME} n'existe pas"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Port Check') {
            steps {
                script {
                    echo "🌐 Vérification du port..."
                    sh '''
                        # Vérifier que le port est en écoute
                        sleep 2
                        if netstat -tln | grep -q ":${VITE_PORT} "; then
                            echo "✅ Le port ${VITE_PORT} est actif"
                        else
                            echo "⚠️  Le port ${VITE_PORT} ne semble pas actif, vérification via docker..."
                            docker port ${CONTAINER_NAME} || true
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                echo "✅ Pipeline terminé avec succès!"
                sh '''
                    echo "📊 Résumé du déploiement :"
                    echo "- Image : ${IMAGE_NAME}:${IMAGE_TAG}"
                    echo "- Conteneur : ${CONTAINER_NAME}"
                    echo "- Port : ${VITE_PORT}"
                    echo "- URL : http://localhost:${VITE_PORT}"
                    echo "- Mémoire : ${MEMORY_LIMIT} (réservation: ${MEMORY_RESERVATION})"
                    echo "- CPU Shares : ${CPU_SHARES}"
                    echo ""
                    echo "Accédez à l'application à http://localhost:${VITE_PORT}"
                '''
            }
        }
        
        failure {
            script {
                echo "❌ Pipeline échoué!"
                sh '''
                    echo "📋 Diagnostique :"
                    echo "--- Logs du conteneur ---"
                    docker logs ${CONTAINER_NAME} 2>&1 | tail -50 || echo "Conteneur non trouvé"
                    echo ""
                    echo "--- Images disponibles ---"
                    docker images | grep ${IMAGE_NAME} || echo "Aucune image trouvée"
                    echo ""
                    echo "--- Conteneurs ---"
                    docker ps -a --filter "name=${CONTAINER_NAME}" || true
                '''
            }
        }

        always {
            script {
                echo "🧹 Nettoyage..."
                sh '''
                    # Garder les workspace clean
                    echo "✅ Workspace nettoyé"
                '''
            }
        }

        unstable {
            script {
                echo "⚠️  Pipeline instable"
            }
        }
    }
}