# =========================================
# HetsOne — Variables d'environnement
# =========================================

# ---- Application ----
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_CONTAINER=http://hetsone-frontend:5173
API_VERSION=v1

# ---- Base de données (PostgreSQL) ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=hetsone_user
DB_PASSWORD=hetsone_password
DB_NAME=hetsone_db
DB_SSL=false

# ---- ORM (TypeORM) ----
TYPEORM_CONNECTION=postgres
TYPEORM_HOST=${DB_HOST}
TYPEORM_PORT=${DB_PORT}
TYPEORM_USERNAME=${DB_USER}
TYPEORM_PASSWORD=${DB_PASSWORD}
TYPEORM_DATABASE=${DB_NAME}
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS_RUN=true
TYPEORM_ENTITIES=dist/**/*.entity.js
TYPEORM_MIGRATIONS=dist/database/migrations/*.js

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
TICKET_RESERVATION_TTL_SECONDS=600

# ---- Authentification / JWT ----
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---- Email (Nodemailer + Gmail SMTP en priorité, Resend en secours) ----
# Le service utilise Nodemailer SMTP dès que MAIL_USER / MAIL_PASSWORD sont
# de vraies identifiants ; sinon il retombe sur Resend API (RESEND_API_KEY).
#
# Option 1 (recommandée) : Nodemailer + Gmail SMTP
# App Password requis : https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre-email@gmail.com
MAIL_PASSWORD=votre-app-password-gmail
MAIL_FROM=HetsOne <votre-email@gmail.com>
MAIL_SECURE=false
#
# Option 2 : Resend API (utilisé seulement si MAIL_USER/MAIL_PASSWORD sont vides ou placeholder)
# Domaines à vérifier : https://resend.com/domains
RESEND_API_KEY=re_your_api_key_here

# ---- MinIO (stockage des images uploadées) ----
# Console d'administration : http://localhost:9001
# En Docker l'hôte est le service `minio` ; hors Docker utilisez `localhost`.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-password
# Optionnel : identifiants dédiés au backend (sinon MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hetsone-uploads
# Mettre à `false` pour garder le bucket privé (les URLs publiques ne seront alors plus servies)
MINIO_BUCKET_PUBLIC=true
# URL publique utilisée dans les URLs renvoyées aux clients (bucket en lecture publique)
MINIO_PUBLIC_URL=http://localhost:9000

# ---- QR Code / Billetterie ----
QR_SIGNING_SECRET=change-me-in-production
QR_TOKEN_EXPIRY_MINUTES=60

# ---- Réservations / Commandes ----
TICKET_RESERVATION_TTL_SECONDS=600
RESERVATION_CLEANUP_CRON=*/1 * * * *

# ---- Paiements ----
PAYMENT_PROVIDERS=mvola,orange,airtel,card
PAYMENT_SANDBOX=false

# ---- Plateforme ----
PLATFORM_NAME=Hetsone
DEFAULT_CURRENCY=MGA
SUPPORT_EMAIL=support@hetsone.mg

# ---- Tokens / Vérification ----
PASSWORD_RESET_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ---- Abonnement SaaS ----
TRIAL_DURATION_DAYS=14
